{
  "name": "sunday-powerpoints",
  "version": "0.0.1",
  "description": "copy a template for each Sunday of the month",
  "main": "lib/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts --ignore src/webapp --exec ts-node src/server.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "start": "ts-node src/index.ts",
    "docker:stop": "docker stop sunday-powerpoints || true",
    "docker:rm": "docker rm sunday-powerpoints || true",
    "docker:build": "docker build -t sunday-powerpoints .",
    "docker:run": "docker run --name sunday-powerpoints -p 0.0.0.0:8080:8080 -e PORT=8080 -e NODE_ENV=development -e ROOT_PATH=P:/ -v \"c:/Users/NathanBaker/OneDrive/PowerPoints/Sunday PowerPoints:/input\" -v \"c:/Users/NathanBaker/OneDrive/PowerPoints/Sermon Videos/Sermons:/output\" -v \"c:/Users/NathanBaker/OneDrive/PowerPoints/songs:/songs\" -d sunday-powerpoints",
    "docker:build-n-run": "npm run docker:stop && npm run docker:rm && npm run docker:build && npm run docker:run",
    "docker:stop-n-run": "npm run docker:stop && npm run docker:rm && npm run docker:run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "pcnate@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcnate/sunday-powerpoints.git"
  },
  "bugs": {
    "url": "https://github.com/pcnate/sunday-powerpoints/issues"
  },
  "homepage": "https://github.com/pcnate/sunday-powerpoints#readme",
  "dependencies": {
    "@angular/cdk": "^20.0.5",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/forms": "^20.0.6",
    "@angular/material": "^20.0.5",
    "@angular/platform-browser": "^20.0.6",
    "@angular/router": "^20.0.6",
    "await-to-js": "^3.0.0",
    "bootstrap": "^5.3.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fs-extra": "^10.0.0",
    "moment": "^2.29.1",
    "node-schedule": "^2.1.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "tslib": "^2.8.1",
    "windows-shortcuts": "^0.1.6",
    "yargs": "^17.7.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.5",
    "@angular/cli": "^20.0.5",
    "@angular/compiler-cli": "^20.0.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.2",
    "@semantic-release/npm": "^12.0.1",
    "@types/express": "^5.0.2",
    "@types/jasmine": "^5.1.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@types/yargs": "^17.0.33",
    "cross-env": "^7.0.3",
    "jasmine-core": "^5.8.0",
    "jest": "^29.7.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "nodemon": "^3.1.10",
    "semantic-release": "^24.2.4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "private": true
}
