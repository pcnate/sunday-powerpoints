# Server
PORT=8080

# Template configuration
TEMPLATE_FILE=Sunday Template.pptx
EXT=pptx
TEMPLATE_DIRECTORY=C:\path\to\template\directory
OUTPUT_DIRECTORY=C:\path\to\output\directory
SONGS_DIRECTORY=C:\path\to\songs\directory
SONG_TEMPLATE=000 - Song Template.pptx
ROOT_PATH=%OneDriveConsumer%

# MySQL (job system - optional, server runs without it)
MYSQL_HOST=192.168.1.50
MYSQL_PORT=3306
MYSQL_USER=sunday_powerpoints
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=sunday_powerpoints

# Job system tuning
HEARTBEAT_TIMEOUT_MS=120000
